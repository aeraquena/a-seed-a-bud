// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  WATER
  REPOT
}

enum PotMaterial {
  PLASTIC
  CERAMIC
  TERRACOTTA
  GLASS
  OTHER
}

enum Substrate {
  SOIL
  SOIL_WITH_DRAINAGE
  SPHAGNUM_MOSS
  WATER
}

model Plant {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  events      Event[]
  index       Int?
  site        Site?    @relation(fields: [siteId], references: [id])
  health      Int?
  siteId      Int?
  propagation Boolean  @default(false)
  speciesId   Int?
  species     Species? @relation(fields: [speciesId], references: [id])
  potSize     Int?
  potMaterial PotMaterial?
  substrate   Substrate?
  source      String?
  dateAcquired  DateTime?
  cost        Int?
  alive       Boolean @default(true)
}

model Event {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  date      DateTime  @default(now())
  type      EventType @default(WATER)
  plantId   Int
  plant     Plant     @relation(fields: [plantId], references: [id])
}

model Site {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String @unique
  plants    Plant[]
  index     Int
}

model Species {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  common_name     String
  scientific_name String
  genusId         Int
  genus           Genus    @relation(fields: [genusId], references: [id])
  plants          Plant[]
}

model Genus {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  name      String
  species   Species[]
}
